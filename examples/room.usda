#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }
    def Cube "Floor" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        double size = 2
        double3 xformOp:translate = (0, 0, -0.05)
        double3 xformOp:scale = (4, 4, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "NorthWall" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        double size = 2
        double3 xformOp:translate = (0, 4, 1.5)
        double3 xformOp:scale = (4.1, 0.1, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "SouthWall" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        double size = 2
        double3 xformOp:translate = (0, -4, 1.5)
        double3 xformOp:scale = (4.1, 0.1, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "EastWall" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        double size = 2
        double3 xformOp:translate = (4, 0, 1.5)
        double3 xformOp:scale = (0.1, 4, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "WestWall" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        double size = 2
        double3 xformOp:translate = (-4, 0, 1.5)
        double3 xformOp:scale = (0.1, 4, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Table" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        custom string semantic:class = "table"
        double size = 2
        double3 xformOp:translate = (1, 1, 0.4)
        double3 xformOp:scale = (0.6, 0.4, 0.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Cup" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        custom string semantic:class = "cup"
        double size = 2
        double3 xformOp:translate = (1, 1, 0.9)
        double3 xformOp:scale = (0.08, 0.08, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
